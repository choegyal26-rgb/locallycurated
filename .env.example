# Postgres connection (Neon, Supabase, or local)
DATABASE_URL=postgres://user:password@localhost:5432/locallycurated

# Resend API key for sending digests
RESEND_API_KEY=re_xxx
RESEND_FROM="LocallyCurated <hello@yourdomain.com>"

# Admin login (used by /admin)
ADMIN_PASSWORD=change-me

# Cron secret — Vercel sends this in Authorization header for cron routes
CRON_SECRET=generate-a-long-random-string

# Optional API keys for richer scrapers
TICKETMASTER_API_KEY=
EVENTBRITE_TOKEN=

# Public site URL (for unsubscribe links etc.)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# CARTO basemap key for the homepage map (Dark Matter tiles). Without it the
# map falls back to Esri's keyless dark gray tiles.
NEXT_PUBLIC_CARTO_API_KEY=
